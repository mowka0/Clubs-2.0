      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clubs-prod"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select coalesce(payment_method, '—') as \"Способ\", count(*) as \"Оплат\"\nfrom platform_payment\nwhere status = 'SUCCEEDED' and $__timeFilter(paid_at)\ngroup by 1 order by 2 desc"
        }
