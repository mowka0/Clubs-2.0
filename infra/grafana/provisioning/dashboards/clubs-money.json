  "panels": [
    {
      "type": "stat",
      "title": "Подписки сейчас и оплаты за период",
      "description": "«Платят» и MRR — определения funnel.md § 3.3: ACTIVE × цена плана CHAT; отменившие не продлятся.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clubs-prod"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clubs-prod"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "with price as (\n  select price_kopecks from subscription_pricing\n  where plan = 'CHAT' and effective_from <= now()\n  order by effective_from desc limit 1\n)\nselect\n  (select count(*) from service_subscription\n     where subject_club_id is not null and status in ('ACTIVE', 'CANCELLED_PENDING_END')) as \"Платят (чатов)\",\n  round(((select count(*) from service_subscription where subject_club_id is not null and status = 'ACTIVE') * (select price_kopecks from price)) / 100.0, 2) as \"MRR, ₽\",\n  (select count(*) from service_subscription where subject_club_id is not null and status = 'PAST_DUE') as \"В грейсе (PAST_DUE)\",\n  (select count(*) from service_subscription where subject_club_id is not null and status = 'CANCELLED_PENDING_END') as \"Отменили, доживают\",\n  round((select coalesce(sum(amount_kopecks), 0) from platform_payment where status = 'SUCCEEDED' and $__timeFilter(paid_at)) / 100.0, 2) as \"Оплачено за период, ₽\",\n  (select round(coalesce(sum(provider_fee), 0), 2) from platform_payment\n     where status = 'SUCCEEDED' and $__timeFilter(paid_at)) as \"Комиссия Robokassa, ₽\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MRR, ₽"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyRUB"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Оплачено за период, ₽"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyRUB"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Комиссия Robokassa, ₽"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyRUB"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
