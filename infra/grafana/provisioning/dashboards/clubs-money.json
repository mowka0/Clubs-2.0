        "wideLayout": true
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Оплаты по неделям",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clubs-prod"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clubs-prod"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select date_trunc('week', paid_at at time zone 'Europe/Moscow') at time zone 'Europe/Moscow' as time,\n  round((coalesce(sum(amount_kopecks) filter (where kind = 'MOTHER'), 0)) / 100.0, 2) as \"Со страницы оплаты\",\n  round((coalesce(sum(amount_kopecks) filter (where kind = 'RECURRING'), 0)) / 100.0, 2) as \"Автосписания\"\nfrom platform_payment\nwhere status = 'SUCCEEDED' and $__timeFilter(paid_at)\ngroup by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "unit": "currencyRUB"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Счета по статусу",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clubs-prod"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clubs-prod"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select date_trunc('week', created_at at time zone 'Europe/Moscow') at time zone 'Europe/Moscow' as time,\n  count(*) filter (where status = 'SUCCEEDED') as \"Оплачены\",\n  count(*) filter (where status = 'FAILED') as \"Не оплачены\",\n  count(*) filter (where status = 'PENDING') as \"Висят\"\nfrom platform_payment\nwhere $__timeFilter(created_at)\ngroup by 1 order by 1"
        }
      ],
