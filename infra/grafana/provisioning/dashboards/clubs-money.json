      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clubs-prod"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select date_trunc('week', created_at at time zone 'Europe/Moscow') at time zone 'Europe/Moscow' as time, round((sum(amount_kopecks)) / 100.0, 2) as \"Выставлено\"\nfrom debts where debtor_id <> creditor_id and $__timeFilter(created_at) group by 1 order by 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clubs-prod"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select date_trunc('week', confirmed_at at time zone 'Europe/Moscow') at time zone 'Europe/Moscow' as time, round((sum(amount_kopecks)) / 100.0, 2) as \"Получено\"\nfrom debts where debtor_id <> creditor_id and status = 'received' and confirmed_at is not null\n  and $__timeFilter(confirmed_at) group by 1 order by 1"
        }
