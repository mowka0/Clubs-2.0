    {
      "type": "stat",
      "title": "Долги сейчас",
      "description": "Доля создателя сбора (должник = получатель) исключена: она закрывается сразу.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
