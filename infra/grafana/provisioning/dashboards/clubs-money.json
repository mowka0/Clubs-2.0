      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clubs-prod"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select\n  count(*) filter (where status in ('waiting', 'promised', 'claimed')) as \"Открытых\",\n  round((coalesce(sum(amount_kopecks) filter (where status in ('waiting', 'promised', 'claimed')), 0)) / 100.0, 2) as \"Открытых, ₽\",\n  count(*) filter (where status in ('waiting', 'promised') and due_at < now()) as \"Просрочено\",\n  count(*) filter (where status = 'claimed') as \"Ждут «Получил»\"\nfrom debts\nwhere debtor_id <> creditor_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
