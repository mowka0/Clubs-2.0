    {
      "type": "table",
      "title": "Подписки чатов (кроме завершённых)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clubs-prod"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clubs-prod"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select c.name as \"Клуб\",\n  s.status as \"Статус\",\n  s.current_period_end as \"Период до\",\n  case when s.autopay then 'да' else 'нет' end as \"Автопродление\",\n  case when s.autopay_possible then 'да' else 'нет' end as \"Карта сохранена\",\n  s.charge_attempts as \"Попыток списания\",\n  s.created_at as \"Оформлена\"\nfrom service_subscription s\njoin clubs c on c.id = s.subject_club_id\nwhere s.status <> 'ENDED'\norder by s.current_period_end"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ]
        }
      },
      "id": 5
    },
    {
      "type": "bargauge",
      "title": "Платёжная воронка за период (клубов)",
      "description": "В6. Шаги — product-analytics.md § 3.1 и § 3.2; считаются клубы.",
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "clubs-prod"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "clubs-prod"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select\n  count(distinct club_id) filter (where kind = 'trial_started') as \"Бесплатный период начат\",\n  count(distinct club_id) filter (where kind = 'paywall_seen') as \"Упёрлись в пейволл\",\n  count(distinct club_id) filter (where kind = 'pay_sheet_opened') as \"Открыли шит оплаты\",\n  count(distinct club_id) filter (where kind = 'checkout_started') as \"Перешли к оплате\",\n  count(distinct club_id) filter (where kind = 'payment_succeeded') as \"Оплатили\",\n  count(distinct club_id) filter (where kind = 'subscription_ended') as \"Подписка закончилась\"\nfrom product_event\nwhere kind in ('trial_started', 'paywall_seen', 'pay_sheet_opened', 'checkout_started', 'payment_succeeded', 'subscription_ended')\n  and $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "valueMode": "color",
        "namePlacement": "top",
        "sizing": "auto",
        "minVizHeight": 16
      },
      "id": 6
